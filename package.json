{
  "name": "map-flowers-hook",
  "version": "1.0.0",
  "description": "React hook for adding flowers layers on MapLibre and MapBox maps",
  "keywords": [
    "react",
    "hook",
    "maplibre",
    "mapbox",
    "flowers",
    "animation",
    "map",
    "geojson"
  ],
  "author": "Mahdi Nameghi <mnameghi@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/mnameghi/map-flowers-hook#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mnameghi/map-flowers-hook.git"
  },
  "bugs": {
    "url": "https://github.com/mnameghi/map-flowers-hook/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=14.0.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "maplibre-gl": {
      "optional": true
    },
    "mapbox-gl": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.0.0",
    "@types/jest": "^29.5.0",
    "@types/react": "^19.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.9.3"
  }
}
